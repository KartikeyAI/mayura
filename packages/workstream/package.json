{
  "name": "@mayura/workstream",
  "version": "1.0.0-rc.2",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.12.0 <23 || >=24.14.1 <25" },
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./executions": { "types": "./dist/executions.d.ts", "import": "./dist/executions.js" },
    "./humans": { "types": "./dist/humans.d.ts", "import": "./dist/humans.js" },
    "./timers": { "types": "./dist/timers.d.ts", "import": "./dist/timers.js" },
    "./webhooks": { "types": "./dist/webhooks.d.ts", "import": "./dist/webhooks.js" }
