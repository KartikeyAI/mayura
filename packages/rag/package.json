{
  "name": "@mayura/rag",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "description": "Scoped retrieval, durable content-addressed ingestion and permissioned RAG tools.",
  "files": [
    "dist",
    "src/**/*.ts",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./host": {
      "types": "./dist/host.d.ts",
      "import": "./dist/host.js"
    }
  },
  "dependencies": {
    "@mayura/core": "workspace:*",
    "@mayura/tools": "workspace:*",
    "@mayura/workflows": "workspace:*",
    "@mayura/storage-contracts": "workspace:*",
    "@mayura/memory": "workspace:*"
  },
  "devDependencies": {
    "@mayura/storage-sqlite": "workspace:*"
  }
}
