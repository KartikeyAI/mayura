{
  "name": "mayura-starter-cli-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A command-line assistant on Mayura: chat or one-shot requests about the folder you run it in, with file tools confined to that folder, confirmed writes, skills and streaming replies.",
  "engines": {
    "node": ">=22.12.0 <23 || >=24.14.1 <25"
  },
  "bin": {
    "assistant": "dist/src/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.json && node --test \"dist/test/*.test.js\"",
    "dev": "tsc -p tsconfig.json && node dist/src/cli.js chat",
    "chat": "node dist/src/cli.js chat",
    "ask": "node dist/src/cli.js"
  },
  "dependencies": {
    "mayura": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "26.6.3",
    "typescript": "7.0.2"
  }
}
