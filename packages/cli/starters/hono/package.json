{
  "name": "mayura-starter-hono",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "hono notebook with persistent scoped threads, exact approvals and a bounded background worker.",
  "engines": {
    "node": ">=24.14.1 <25"
  },
  "mayuraStarter": {
    "kind": "framework",
    "apiPrefix": "/api/mayura",
    "ui": "react-copy-in"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "test": "node --test test/*.test.mjs",
    "worker": "node --env-file-if-exists=.env server/worker.mjs",
    "typecheck": "tsc --noEmit",
    "dev": "node scripts/dev.mjs",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env server/hono-node.mjs",
    "dev:workers": "wrangler dev --port 3000",
    "deploy:workers": "wrangler deploy",
    "start:bun": "bun --env-file=.env server/bun.mjs",
    "start:deno": "deno run --env-file=.env --allow-net --allow-env --allow-read=dist/client,node_modules --allow-sys server/deno.mjs"
  },
  "dependencies": {
    "mayura": "workspace:*",
    "better-sqlite3": "13.0.3",
    "pg": "8.23.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "hono": "4.13.9",
    "@hono/node-server": "2.1.1",
    "@mayurajs/storage-d1": "workspace:*"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "vite": "8.3.5",
    "@vitejs/plugin-react": "6.1.2",
    "wrangler": "^4.151.3"
  }
}
