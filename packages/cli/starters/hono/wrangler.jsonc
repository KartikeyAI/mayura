{
  "name": "mayura-notebook",
  "main": "server/worker-edge.mjs",
  "compatibility_date": "2026-10-20",
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/mayura/*"
    ]
  },
  "vars": {
    "MAYURA_PUBLIC_ORIGIN": "https://replace-with-your-worker.workers.dev",
    "MAYURA_PROJECT_ID": "notebook"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mayura-notebook",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID"
    }
  ],
  "triggers": {
    "crons": [
      "* * * * *"
    ]
  }
}
