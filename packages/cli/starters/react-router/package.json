{
  "name": "mayura-starter-react-router",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "react-router notebook with persistent scoped threads, exact approvals and a bounded background worker.",
  "engines": {
    "node": ">=24.14.1 <25"
  },
  "mayuraStarter": {
    "kind": "framework",
    "apiPrefix": "/api/mayura",
    "ui": "react-copy-in"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "test": "node --test test/*.test.mjs",
    "worker": "node --env-file-if-exists=.env server/worker.mjs",
    "typecheck": "react-router typegen && tsc --noEmit",
    "dev": "react-router dev --host 127.0.0.1 --port 3000",
    "build": "react-router build",
    "start": "react-router-serve ./build/server/index.js"
  },
  "dependencies": {
    "mayura": "workspace:*",
    "better-sqlite3": "13.0.3",
    "pg": "8.23.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "7.18.4",
    "@react-router/node": "7.18.4",
    "@react-router/serve": "7.18.4",
    "isbot": "5.2.2"
  },
  "devDependencies": {
    "typescript": "6.0.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@react-router/dev": "7.18.4",
    "vite": "8.3.5"
  }
}
