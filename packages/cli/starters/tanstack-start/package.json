{
  "name": "mayura-starter-tanstack-start",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "tanstack-start notebook with persistent scoped threads, exact approvals and a bounded background worker.",
  "engines": {
    "node": ">=24.14.1 <25"
  },
  "mayuraStarter": {
    "kind": "framework",
    "apiPrefix": "/api/mayura",
    "ui": "react-copy-in"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "test": "node --test test/*.test.mjs",
    "worker": "node --env-file-if-exists=.env server/worker.mjs",
    "typecheck": "tsc --noEmit",
    "dev": "vite --host 127.0.0.1 --port 3000",
    "build": "vite build",
    "start": "node .output/server/index.mjs"
  },
  "dependencies": {
    "mayura": "workspace:*",
    "better-sqlite3": "13.0.3",
    "pg": "8.23.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "@tanstack/react-router": "1.170.40",
    "@tanstack/react-start": "1.168.59"
  },
  "devDependencies": {
    "typescript": "6.0.3",
    "@types/node": "24.13.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "vite": "8.3.0",
    "nitro": "3.0.260903-beta"
  }
}
