{
  "name": "mayura-starter-nextjs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "nextjs notebook with persistent scoped threads, exact approvals and a bounded background worker.",
  "engines": {
    "node": ">=24.14.1 <25"
  },
  "mayuraStarter": {
    "kind": "framework",
    "apiPrefix": "/api/mayura",
    "ui": "react-copy-in"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "test": "node --test test/*.test.mjs",
    "worker": "node --env-file-if-exists=.env server/worker.mjs",
    "typecheck": "next typegen && tsc --noEmit",
    "dev": "next dev --hostname 127.0.0.1 --port 3000",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0"
  },
  "dependencies": {
    "mayura": "workspace:*",
    "better-sqlite3": "13.0.3",
    "pg": "8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "next": "16.4.2"
  },
  "devDependencies": {
    "typescript": "6.0.3",
    "@types/node": "24.13.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0"
  }
}
