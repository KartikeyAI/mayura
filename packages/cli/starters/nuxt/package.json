{
  "name": "mayura-starter-nuxt",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "nuxt notebook with persistent scoped threads, exact approvals and a bounded background worker.",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "mayuraStarter": {
    "kind": "framework",
    "apiPrefix": "/api/mayura",
    "ui": "headless"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "test": "node --test test/*.test.mjs",
    "worker": "node --env-file-if-exists=.env server/worker.mjs",
    "typecheck": "nuxt typecheck",
    "dev": "nuxt dev --host 127.0.0.1 --port 3000",
    "build": "nuxt build",
    "start": "node --env-file-if-exists=.env .output/server/index.mjs"
  },
  "dependencies": {
    "mayura": "workspace:*",
    "better-sqlite3": "13.0.3",
    "pg": "8.23.0",
    "nuxt": "4.5.2",
    "vue": "3.5.44",
    "h3": "1.15.11"
  },
  "devDependencies": {
    "typescript": "6.0.3",
    "@types/node": "24.13.6",
    "vue-tsc": "^3.0.0"
  }
}
