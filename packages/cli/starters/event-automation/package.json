{
  "name": "mayura-starter-event-automation",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Signed ticket webhooks start durable Mayura workflows in which a triage agent acts on the tracker through MCP tools under explicit capability grants.",
  "engines": {
    "node": ">=22.12.0 <23 || >=24.14.1 <25"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.json && node --test \"dist/test/*.test.js\"",
    "dev": "mayura dev",
    "send-sample": "node dist/src/send-sample.js",
    "tracker": "node dist/src/tracker/main.js",
    "token": "node dist/src/token.js",
    "migrate": "mayura migrate --app dist/src/app.js",
    "serve": "mayura serve --app dist/src/app.js",
    "worker": "mayura worker --app dist/src/app.js --probe-host 0.0.0.0 --probe-port 9090"
  },
  "dependencies": {
    "better-sqlite3": "13.0.3",
    "mayura": "workspace:*",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@types/node": "24.13.6",
    "typescript": "7.0.2"
  }
}
