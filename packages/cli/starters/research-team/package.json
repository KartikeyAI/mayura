{
  "name": "mayura-starter-research-team",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Multi-agent research on Mayura: a planner, parallel researchers over a source library and a writer, as one durable workflow under one shared budget, with cited reports stored as content-addressed artifacts.",
  "engines": { "node": ">=22.12.0 <23 || >=24.14.1 <25" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.json && node --test \"dist/test/*.test.js\"",
    "dev": "mayura dev",
    "token": "node dist/src/token.js",
    "migrate": "mayura migrate --app dist/src/app.js",
    "serve": "mayura serve --app dist/src/app.js",
    "worker": "mayura worker --app dist/src/app.js --probe-host 0.0.0.0 --probe-port 9090"
  },
  "dependencies": {
    "@mayura/artifacts": "workspace:*",
    "@mayura/cli": "workspace:*",
    "@mayura/client": "workspace:*",
    "@mayura/core": "workspace:*",
    "@mayura/exporter-otlp": "workspace:*",
    "@mayura/helpers": "workspace:*",
    "@mayura/observability": "workspace:*",
    "@mayura/provider-anthropic": "workspace:*",
    "@mayura/provider-openai": "workspace:*",
    "@mayura/sdk": "workspace:*",
    "@mayura/server-node": "workspace:*",
    "@mayura/storage-contracts": "workspace:*",
    "@mayura/storage-postgres": "workspace:*",
    "@mayura/storage-sqlite": "workspace:*",
    "@mayura/workflows": "workspace:*",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "24.13.6",
    "typescript": "7.0.2"
  }
}
