{
  "name": "mayura-starter-sveltekit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "sveltekit notebook with persistent scoped threads, exact approvals and a bounded background worker.",
  "engines": {
    "node": ">=24.14.1 <25"
  },
  "mayuraStarter": {
    "kind": "framework",
    "apiPrefix": "/api/mayura",
    "ui": "headless"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "test": "node --test test/*.test.mjs",
    "worker": "node --env-file-if-exists=.env server/worker.mjs",
    "typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "dev": "vite --host 127.0.0.1 --port 3000",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env build/index.js"
  },
  "dependencies": {
    "mayura": "workspace:*",
    "better-sqlite3": "13.0.3",
    "pg": "8.23.0",
    "svelte": "^5.57.1"
  },
  "devDependencies": {
    "typescript": "6.0.3",
    "@types/node": "26.6.5",
    "@sveltejs/kit": "3.1.0",
    "@sveltejs/adapter-node": "6.0.0",
    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "svelte-check": "^4.0.0",
    "vite": "8.3.5"
  }
}
