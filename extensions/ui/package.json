{
  "name": "@mayurajs/ui",
  "version": "1.3.0",
  "private": true,
  "description": "Tailwind React components for agent chat, thread history, artifacts, citations and AG-UI approvals.",
  "type": "module",
  "sideEffects": ["./dist/styles.css"],
  "files": ["dist", "src/**/*.ts", "src/**/*.tsx", "README.md"],
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./ag-ui": { "types": "./dist/ag-ui.d.ts", "import": "./dist/ag-ui.js" },
    "./styles.css": { "types": "./dist/styles.css.d.ts", "default": "./dist/styles.css" }
  },
  "engines": { "node": ">=22.12.0 <23 || >=24.14.1 <25" },
  "peerDependencies": { "mayura": "workspace:^", "react": ">=19 <20" },
  "peerDependenciesMeta": { "mayura": { "optional": true } },
  "devDependencies": {
    "@tailwindcss/node": "4.3.3",
    "@tailwindcss/oxide": "4.3.3",
    "postcss": "8.5.28",
    "tailwindcss": "4.3.3"
  }
}
