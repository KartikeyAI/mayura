# Mayura: the variables a full test run needs, for every integrated platform and the local test infrastructure.
#
# Copy this file to .env.live (git-ignored) and fill in what you have. An empty value counts as unset, so the
# checks for anything left empty are skipped. Never commit real values, and never put them in this file.
# Mayura's packages read nothing from the environment themselves: these are read by the test runs and live checks.
#
#   Model providers:  node --env-file=.env.live scripts/provider-live-check.mjs
#   Live scripts:     node --env-file=.env.live scripts/live/<package>.mjs   (see scripts/live/README.md)
#   Local tier 2:     pnpm test:integration and the rest of the CI list, with the [local] values below
#
# Status of each platform:
#   [live script] A live check script exists and runs with these variables.
#   [live check] pnpm providers:live-check runs with these variables.
#   [local] Runs on this machine in the tier-2 run; no account.
#   [no live check yet] Verified with fakes and emulators; these variables are named for a live check still to write.


# ====================================================================================================================
# Shared cloud accounts
#
# Accounts several packages use. Each variable is set once here and named again where it is used.
# ====================================================================================================================

# --- Amazon Web Services [live script]  https://console.aws.amazon.com/iam/
# sandbox-agentcore, provider-bedrock, storage-dynamodb, mayura/files (S3), deploy-aws-*, deploy-agentcore
# Setup: Use a separate test account or a narrowly scoped IAM user: Bedrock model access, AgentCore Code Interpreter, DynamoDB, S3, ECR, ECS and Lambda as each check needs.
# An IAM user or role key for a test account.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Only with temporary credentials.
AWS_SESSION_TOKEN=
# Bedrock catalog prices apply in us-east-1.
AWS_REGION=us-east-1

# --- Cloudflare [live script]  https://dash.cloudflare.com https://dash.cloudflare.com/profile/api-tokens
# browser-cloudflare, cloudflare-quick-action, sandbox-cloudflare, storage-d1, filestorage-r2, deploy-cloudflare
# The account id (32 hex characters).
CLOUDFLARE_ACCOUNT_ID=
# For wrangler (deploys, D1 and R2 against the real account): Workers, D1 and R2 edit.
CLOUDFLARE_API_TOKEN=

# --- Google Cloud [no live check yet]  https://console.cloud.google.com https://console.cloud.google.com/apis/credentials
# voice-google, filestorage-gcs, filestorage-google-drive, deploy-cloudrun
# Setup: Enable Speech-to-Text, Text-to-Speech, Cloud Storage, Drive, Cloud Run, Cloud Build, Artifact Registry and Secret Manager as each check needs.
# The project id.
GOOGLE_CLOUD_PROJECT=
# Path to a service-account JSON file (never its contents), for access tokens.
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_CLOUD_REGION=us-central1

# --- Microsoft Azure [no live check yet]  https://portal.azure.com
# provider-azure, voice-azure, filestorage-azure-blob, deploy-azure
# A service principal for az login in a test run.
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_SUBSCRIPTION_ID=
# A resource group for test resources.
AZURE_RESOURCE_GROUP=

# --- Vercel [live script]  https://vercel.com/account/tokens
# sandbox-vercel, deploy-vercel, filestorage-vercel-blob
VERCEL_TOKEN=
# team_...
VERCEL_TEAM_ID=
# prj_...
VERCEL_PROJECT_ID=

# --- OpenAI [live check]  https://platform.openai.com/api-keys
# provider live check, provider-openai, voice-openai
OPENAI_API_KEY=

# --- Anthropic [live check]  https://console.anthropic.com/settings/keys
# provider live check, provider-anthropic
ANTHROPIC_API_KEY=

# ====================================================================================================================
# Local test infrastructure (tier 2)
#
# Containers and tools on this machine for pnpm test:integration and the rest of the tier-2 run; no account needed.
# The values are local test-only settings.
# ====================================================================================================================

# --- PostgreSQL [local]  https://www.postgresql.org
# storage-postgres and every store test
# Setup: docker compose -f compose.test.yaml up -d --pull never
MAYURA_TEST_POSTGRES_URL=postgresql://mayura:mayura_local_test_only@127.0.0.1:55258/mayura

# --- MySQL [local]  https://dev.mysql.com/downloads/
# storage-mysql
# Setup: docker run -d -p 127.0.0.1:13306:3306 -e MYSQL_ROOT_PASSWORD=mayura_test_only mysql:8.4
MAYURA_TEST_MYSQL_URL=mysql://root:mayura_test_only@127.0.0.1:13306/mysql

# --- MongoDB [local]  https://www.mongodb.com
# storage-mongodb, better-auth tests
# Setup: docker run -d -p 127.0.0.1:27018:27017 mongo:8.0 --replSet rs0 --bind_ip_all, then rs.initiate() in mongosh
MAYURA_TEST_MONGODB_URL=mongodb://127.0.0.1:27018/?replicaSet=rs0&directConnection=true

# --- DynamoDB Local [local]  https://docs.aws.amazon.com/amazondynamodb/latest/developerguide/DynamoDBLocal.html
# storage-dynamodb
# Setup: docker run -d -p 127.0.0.1:18000:8000 amazon/dynamodb-local -jar DynamoDBLocal.jar -inMemory -sharedDb
MAYURA_TEST_DYNAMODB_URL=http://127.0.0.1:18000

# --- libSQL server [local]  https://github.com/tursodatabase/libsql
# storage-libsql
# Setup: docker run -d -p 127.0.0.1:18080:8080 ghcr.io/tursodatabase/libsql-server
MAYURA_TEST_LIBSQL_URL=ws://127.0.0.1:18080

# --- S3 (RustFS) [local]  https://github.com/rustfs/rustfs
# mayura/files S3, filestorage-files-sdk, artifacts
# Setup: docker run -d -p 127.0.0.1:19000:9000 -e RUSTFS_ACCESS_KEY=mayuratest -e RUSTFS_SECRET_KEY=mayuratest-secret-key rustfs/rustfs
# The user and password are the access key and secret.
MAYURA_TEST_S3_URL=http://mayuratest:mayuratest-secret-key@127.0.0.1:19000

# --- fake-gcs-server [local]  https://github.com/fsouza/fake-gcs-server
# filestorage-gcs
# Setup: docker run -d -p 127.0.0.1:14443:4443 fsouza/fake-gcs-server -scheme http -port 4443 -public-host 127.0.0.1:14443
MAYURA_TEST_GCS_URL=http://127.0.0.1:14443

# --- Azurite [local]  https://github.com/Azure/Azurite
# filestorage-azure-blob
# Setup: docker run -d -p 127.0.0.1:10000:10000 mcr.microsoft.com/azure-storage/azurite azurite-blob --blobHost 0.0.0.0
MAYURA_TEST_AZURITE_URL=http://127.0.0.1:10000/devstoreaccount1

# --- Docker sandbox [local]  https://www.docker.com/products/docker-desktop/
# mayura/sandbox (Docker)
# An image already on this machine; never pulled.
MAYURA_TEST_DOCKER_SANDBOX_IMAGE=alpine:3.22
# Engine API socket when not the default (Docker Desktop on Windows: npipe:////./pipe/dockerDesktopLinuxEngine).
MAYURA_TEST_DOCKER_HOST=

# --- Code Mode Docker sandbox [local]  https://www.docker.com/products/docker-desktop/
# adapter-code-docker
# Path to the docker executable.
MAYURA_TEST_DOCKER_PATH=
# The code sandbox image, by digest.
MAYURA_TEST_CODE_SANDBOX_IMAGE=
# Its provenance file.
MAYURA_TEST_CODE_SANDBOX_PROVENANCE=

# --- Local browser [local]  https://www.google.com/chrome/
# mayura/browser and every browser-* fake-session test
# chrome or edge, already installed; nothing is downloaded.
MAYURA_TEST_BROWSER=chrome
# Path to the agent-browser binary or script, for browser-agent-browser.
MAYURA_TEST_AGENT_BROWSER=

# --- Bun and Deno [local]  https://bun.sh https://deno.com
# pnpm test:runtimes
# Path to bun when it is not on PATH.
MAYURA_BUN=
# Path to deno when it is not on PATH.
MAYURA_DENO=

# ====================================================================================================================
# Model providers: live check
#
# pnpm providers:live-check (scripts/provider-live-check.mjs; CONTRIBUTING.md). A provider runs only when its model
# variable is set; then its key and both prices are required. Prices are micros per million tokens.
# ====================================================================================================================

# --- Cost limits [live check]  https://github.com/KartikeyAI/mayura/blob/main/CONTRIBUTING.md
# all providers
# Required: the bound reserved before each request.
MAYURA_LIVE_MAX_CALL_COST_MICROS=
# Required: the cap for the whole run.
MAYURA_LIVE_MAX_TOTAL_COST_MICROS=
MAYURA_LIVE_MAX_OUTPUT_TOKENS=1024
MAYURA_LIVE_TIMEOUT_MS=60000
# A subset of structured,tools,streaming,router_failover,router_streaming,vision,vision_tools; all when empty.
MAYURA_LIVE_CHECKS=

# --- OpenAI (Responses) [live check]  https://platform.openai.com/api-keys
# mayura provider-openai
# Also uses: OPENAI_API_KEY (set once, above or below).
# Selects OpenAI, such as gpt-5.1.
MAYURA_LIVE_OPENAI_MODEL=
MAYURA_LIVE_OPENAI_INPUT_MICROS_PER_MILLION_TOKENS=
MAYURA_LIVE_OPENAI_OUTPUT_MICROS_PER_MILLION_TOKENS=
# Through a gateway: its endpoint.
MAYURA_LIVE_OPENAI_URL=
# Through a gateway: its token (the key is then optional).
MAYURA_LIVE_OPENAI_GATEWAY_TOKEN=

# --- Anthropic (Messages) [live check]  https://console.anthropic.com/settings/keys
# mayura provider-anthropic
# Also uses: ANTHROPIC_API_KEY (set once, above or below).
# Selects Anthropic, such as claude-sonnet-5-5.
MAYURA_LIVE_ANTHROPIC_MODEL=
MAYURA_LIVE_ANTHROPIC_INPUT_MICROS_PER_MILLION_TOKENS=
MAYURA_LIVE_ANTHROPIC_OUTPUT_MICROS_PER_MILLION_TOKENS=
# Through a gateway: its endpoint.
MAYURA_LIVE_ANTHROPIC_URL=
MAYURA_LIVE_ANTHROPIC_GATEWAY_TOKEN=

# --- OpenAI-compatible endpoints [live check]  https://github.com/KartikeyAI/mayura/blob/main/CONTRIBUTING.md
# openAICompatibleChat
# Ids to run, such as deepseek,cloudflare. Each id <ID> takes MAYURA_LIVE_COMPATIBLE_<ID>_URL, _KEY, _MODEL, prices, and optionally _AUTH, _OUTPUT, _STRICT_TOOLS, _TOKEN_LIMIT_FIELD, _MEDIA, _BODY, _GATEWAY_TOKEN.
MAYURA_LIVE_COMPATIBLE=

# --- DeepSeek [live check]  https://platform.deepseek.com/api_keys
# compatible id deepseek; also browser-stagehand
MAYURA_LIVE_COMPATIBLE_DEEPSEEK_URL=https://api.deepseek.com/beta/chat/completions
MAYURA_LIVE_COMPATIBLE_DEEPSEEK_KEY=
# Such as deepseek-flash.
MAYURA_LIVE_COMPATIBLE_DEEPSEEK_MODEL=
MAYURA_LIVE_COMPATIBLE_DEEPSEEK_OUTPUT=json_object
MAYURA_LIVE_COMPATIBLE_DEEPSEEK_STRICT_TOOLS=true
MAYURA_LIVE_COMPATIBLE_DEEPSEEK_INPUT_MICROS_PER_MILLION_TOKENS=
MAYURA_LIVE_COMPATIBLE_DEEPSEEK_OUTPUT_MICROS_PER_MILLION_TOKENS=

# --- Cloudflare AI Gateway [live check]  https://developers.cloudflare.com/ai-gateway/
# compatible id cloudflare
# https://gateway.ai.cloudflare.com/v1/<account>/<gateway>/compat/chat/completions
MAYURA_LIVE_COMPATIBLE_CLOUDFLARE_URL=
# Sent as cf-aig-authorization; the gateway holds the provider keys.
MAYURA_LIVE_COMPATIBLE_CLOUDFLARE_GATEWAY_TOKEN=
# Only when the gateway does not hold the key.
MAYURA_LIVE_COMPATIBLE_CLOUDFLARE_KEY=
# provider/model, such as deepseek/deepseek-flash.
MAYURA_LIVE_COMPATIBLE_CLOUDFLARE_MODEL=
MAYURA_LIVE_COMPATIBLE_CLOUDFLARE_OUTPUT=
MAYURA_LIVE_COMPATIBLE_CLOUDFLARE_STRICT_TOOLS=
# max_completion_tokens for OpenAI's newer models.
MAYURA_LIVE_COMPATIBLE_CLOUDFLARE_TOKEN_LIMIT_FIELD=
# A JSON object of extra request fields.
MAYURA_LIVE_COMPATIBLE_CLOUDFLARE_BODY=
MAYURA_LIVE_COMPATIBLE_CLOUDFLARE_INPUT_MICROS_PER_MILLION_TOKENS=
MAYURA_LIVE_COMPATIBLE_CLOUDFLARE_OUTPUT_MICROS_PER_MILLION_TOKENS=

