# ====================================================================================================================
# Sign-in providers
#
# The @mayurajs/auth-* packages. Each script checks the provider's published keys, then verifies a real token when the
# account variables are set.
# ====================================================================================================================

# --- Clerk [live script]  https://dashboard.clerk.com
# auth-clerk
# Run: node --env-file=.env.live scripts/live/auth-clerk.mjs
# pk_test_... or pk_live_...
CLERK_PUBLISHABLE_KEY=
# The origin tokens are made for, such as http://localhost:3000.
CLERK_AUTHORIZED_PARTY=
# Optional, a fresh session token (lasts 60 s): await window.Clerk.session.getToken().
CLERK_SESSION_TOKEN=

# --- Auth0 [live script]  https://manage.auth0.com
# auth-auth0
# Run: node --env-file=.env.live scripts/live/auth-auth0.mjs
# acme.us.auth0.com
AUTH0_DOMAIN=
# An API's identifier.
AUTH0_AUDIENCE=
# A machine-to-machine application authorized for that API.
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=

# --- Neon Auth [live script]  https://console.neon.tech
# auth-neon
# Run: node --env-file=.env.live scripts/live/auth-neon.mjs
# The project's Neon Auth URL.
NEON_AUTH_BASE_URL=
# Optional, a fresh JWT from your app (lasts 15 minutes).
NEON_AUTH_TOKEN=

# --- Supabase Auth [live script]  https://supabase.com/dashboard
# auth-supabase
# Run: node --env-file=.env.live scripts/live/auth-supabase.mjs
# https://<project>.supabase.co
SUPABASE_URL=
# Or SUPABASE_ANON_KEY on older projects.
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_ANON_KEY=
# A test user with email sign-in.
SUPABASE_TEST_EMAIL=
SUPABASE_TEST_PASSWORD=

# --- Firebase Authentication [live script]  https://console.firebase.google.com
# auth-firebase
# Run: node --env-file=.env.live scripts/live/auth-firebase.mjs
FIREBASE_PROJECT_ID=
# The web app's API key.
FIREBASE_WEB_API_KEY=
# A test user (email/password sign-in enabled).
FIREBASE_TEST_EMAIL=
FIREBASE_TEST_PASSWORD=

# --- WorkOS [live script]  https://dashboard.workos.com
# auth-workos
# Run: node --env-file=.env.live scripts/live/auth-workos.mjs
# client_...
WORKOS_CLIENT_ID=
# Optional, a fresh AuthKit access token from your app.
WORKOS_ACCESS_TOKEN=
# For Connect tokens: https://<name>.authkit.app
WORKOS_AUTHKIT_DOMAIN=
# A machine-to-machine Connect application.
WORKOS_M2M_CLIENT_ID=
WORKOS_M2M_CLIENT_SECRET=

# --- Google Sign-In [live script]  https://console.cloud.google.com/apis/credentials
# auth-google
# Run: node --env-file=.env.live scripts/live/auth-google.mjs
# An OAuth web client id.
GOOGLE_CLIENT_ID=
# Optional, a fresh ID token for that client (lasts an hour), from the OAuth Playground.
GOOGLE_ID_TOKEN=

# --- Facebook Login [live script]  https://developers.facebook.com/apps
# auth-facebook
# Run: node --env-file=.env.live scripts/live/auth-facebook.mjs
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# Optional, a user access token for the app, from the Graph API Explorer.
FACEBOOK_USER_TOKEN=

# --- Microsoft Entra ID [live script]  https://entra.microsoft.com
# auth-entra
# Run: node --env-file=.env.live scripts/live/auth-entra.mjs
ENTRA_TENANT_ID=
# An app registration exposing an API (its client id is the audience).
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=

# --- Okta [live script]  https://developer.okta.com/signup/
# auth-okta
# Run: node --env-file=.env.live scripts/live/auth-okta.mjs
# acme.okta.com
OKTA_DOMAIN=
OKTA_AUTH_SERVER=default
OKTA_AUDIENCE=api://default
# An API services application.
OKTA_CLIENT_ID=
OKTA_CLIENT_SECRET=
# A custom scope on the authorization server.
OKTA_SCOPE=

# --- Amazon Cognito [live script]  https://console.aws.amazon.com/cognito/
# auth-cognito
# Run: node --env-file=.env.live scripts/live/auth-cognito.mjs
# us-east-1_AbCdEf123
COGNITO_USER_POOL_ID=
# acme.auth.us-east-1.amazoncognito.com
COGNITO_DOMAIN=
# An app client with client credentials.
COGNITO_CLIENT_ID=
COGNITO_CLIENT_SECRET=
# A resource server scope, such as agents/use.
COGNITO_SCOPE=

# ====================================================================================================================
# API key services
#
# The @mayurajs/km-* packages. Each script creates a key, checks it, and deletes it.
# ====================================================================================================================

# --- Unkey [live script]  https://app.unkey.com https://www.unkey.com/docs/api-management/keys/verifying-keys
# km-unkey
# Run: node --env-file=.env.live scripts/live/km-unkey.mjs
# Allowed to create, verify and delete keys in the API.
UNKEY_ROOT_KEY=
# api_...
UNKEY_API_ID=
# That API's keyspace, ks_...
UNKEY_KEYSPACE_ID=

# --- ReqKey [live script]  https://reqkey.com/docs/api/keys
# km-reqkey
# Run: node --env-file=.env.live scripts/live/km-reqkey.mjs
REQKEY_ROOT_KEY=
# An API registered in the project.
REQKEY_API_ID=
# A consumer with a few credits.
REQKEY_CONSUMER_ID=

# ====================================================================================================================
# File storage
#
# mayura/files (S3) and the @mayurajs/filestorage-* packages. Locally they run against emulators (above); these are
# for real accounts.
# ====================================================================================================================

# --- Amazon S3 (or B2, MinIO) [no live check yet]  https://console.aws.amazon.com/s3/
# mayura/files s3Files, filestorage-files-sdk
# Also uses: AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY, AWS_REGION (set once, above or below).
# A test bucket.
S3_BUCKET=
# Only for an S3-compatible service other than AWS.
S3_ENDPOINT=

# --- Cloudflare R2 [no live check yet]  https://dash.cloudflare.com/?to=/:account/r2
# mayura/files s3Files (S3 API), filestorage-r2 (Workers binding)
# Also uses: CLOUDFLARE_ACCOUNT_ID (set once, above or below).
# An R2 API token's S3 access key.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# --- Google Cloud Storage [no live check yet]  https://console.cloud.google.com/storage
# filestorage-gcs
# Also uses: GOOGLE_APPLICATION_CREDENTIALS, GOOGLE_CLOUD_PROJECT (set once, above or below).
GCS_BUCKET=

# --- Azure Blob Storage [no live check yet]  https://portal.azure.com
# filestorage-azure-blob
AZURE_STORAGE_ACCOUNT=
# Or a SAS token in AZURE_STORAGE_SAS_TOKEN.
AZURE_STORAGE_KEY=
AZURE_STORAGE_SAS_TOKEN=
AZURE_STORAGE_CONTAINER=

# --- Vercel Blob [no live check yet]  https://vercel.com/dashboard/stores
# filestorage-vercel-blob
# A private store's vercel_blob_rw_... token.
BLOB_READ_WRITE_TOKEN=

# --- Google Drive [no live check yet]  https://console.cloud.google.com/apis/credentials
# filestorage-google-drive
# An OAuth token with drive.file or drive.appdata.
GOOGLE_DRIVE_ACCESS_TOKEN=
# A folder id, or appDataFolder.
GOOGLE_DRIVE_FOLDER_ID=

# --- Mesa [no live check yet]  https://mesa.dev
# filestorage-mesa
MESA_API_KEY=
MESA_ORG=
MESA_REPO=

# --- AgentFS (Turso) [no live check yet]  https://turso.tech
# filestorage-agentfs
# An agent id; a local AgentFS needs no account.
AGENTFS_ID=

# ====================================================================================================================
# Databases
#
# Stores on hosted services. Locally they run against containers (above).
# ====================================================================================================================

# --- PostgreSQL (hosted) [no live check yet]  https://console.neon.tech https://supabase.com/dashboard
# storage-postgres
# A test database the run may create tables in.
POSTGRES_URL=

# --- Turso (libSQL) [no live check yet]  https://app.turso.tech
# storage-libsql
# libsql://<db>-<org>.turso.io
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# --- MongoDB Atlas [no live check yet]  https://cloud.mongodb.com
# storage-mongodb
# A replica set or sharded cluster.
MONGODB_URL=
MONGODB_DATABASE=

# --- MySQL (hosted) [no live check yet]  https://planetscale.com
# storage-mysql
# MySQL 8.0.19 or later; the user may create databases.
MYSQL_URL=

# --- Amazon DynamoDB [no live check yet]  https://console.aws.amazon.com/dynamodb/
# storage-dynamodb
# Also uses: AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY, AWS_REGION (set once, above or below).
# Created on demand when allowed.
DYNAMODB_TABLE=

# --- Cloudflare D1 [no live check yet]  https://developers.cloudflare.com/d1/
# storage-d1
# Also uses: CLOUDFLARE_ACCOUNT_ID, CLOUDFLARE_API_TOKEN (set once, above or below).
# For a check through a deployed Worker or wrangler dev --remote.
D1_DATABASE_ID=

# ====================================================================================================================
# Observability
#
# The @mayurajs/observability-* packages and the OTLP exporter in core.
# ====================================================================================================================

# --- Langfuse [no live check yet]  https://cloud.langfuse.com
# observability-langfuse
# pk-lf-...
LANGFUSE_PUBLIC_KEY=
# sk-lf-...
LANGFUSE_SECRET_KEY=
# eu, us, jp or hipaa.
LANGFUSE_REGION=eu

# --- LangSmith [live script]  https://smith.langchain.com
# observability-langsmith
# Run: node --env-file=.env.live scripts/live/observability-langsmith.mjs
LANGSMITH_API_KEY=
# Optional.
LANGSMITH_PROJECT=

# --- Datadog [no live check yet]  https://app.datadoghq.com
# observability-datadog
DD_API_KEY=
DD_SITE=datadoghq.com
# For LLM Observability.
DD_LLMOBS_ML_APP=

# --- Arize AX [no live check yet]  https://app.arize.com
# observability-arize
ARIZE_SPACE_ID=
ARIZE_API_KEY=
# us, eu or ca.
ARIZE_REGION=us

# --- Phoenix [no live check yet]  https://app.phoenix.arize.com
# observability-arize (phoenixTraceExporter)
# https://app.phoenix.arize.com/s/<space>, or http://127.0.0.1:6006 self-hosted.
PHOENIX_COLLECTOR_ENDPOINT=
PHOENIX_API_KEY=

# --- Sentry [no live check yet]  https://sentry.io
# observability-sentry
# Project, then Client Keys.
SENTRY_DSN=

# --- Better Stack [no live check yet]  https://betterstack.com
# observability-betterstack
# An OpenTelemetry source.
BETTERSTACK_SOURCE_TOKEN=
# s1234.eu-nbg-2.betterstackdata.com
BETTERSTACK_INGESTING_HOST=

# --- PostHog [no live check yet]  https://posthog.com
# observability-posthog
# phc_...
POSTHOG_PROJECT_TOKEN=
# us or eu.
POSTHOG_REGION=us

# --- Any OTLP collector [no live check yet]  https://opentelemetry.io/docs/specs/otlp/
# mayura/exporter-otlp
# The full /v1/traces URL.
OTEL_EXPORTER_OTLP_ENDPOINT=
# key=value,key=value
OTEL_EXPORTER_OTLP_HEADERS=

# ====================================================================================================================
# Deploy
#
# mayura deploy runs each platform's own CLI, which must be installed and logged in (or given the token it reads). No
# live deploy test exists yet; the MAYURA_DEPLOY_* names are for one. Most platforms need their app or service created
# once first.
# ====================================================================================================================

# --- Docker, Compose, Kubernetes [no live check yet]  https://docs.docker.com https://kind.sigs.k8s.io
# mayura deploy (core)
# A registry repository with no tag, such as localhost:5000/mayura-test.
MAYURA_DEPLOY_IMAGE=
# A test cluster's kubeconfig only; never your everyday one.
KUBECONFIG=
# The database migrations run against, for targets that migrate from this machine.
DATABASE_URL=

# --- Fly.io [no live check yet]  https://fly.io
# deploy-fly
# Also uses: FLY_API_TOKEN (set once, above or below).
# Created once with fly apps create.
MAYURA_DEPLOY_FLY_APP=

# --- Railway [no live check yet]  https://railway.com
# deploy-railway
# Setup: railway link, each service's config path set, PostgreSQL added.
# A project token, read by the railway CLI.
RAILWAY_TOKEN=

# --- Render [no live check yet]  https://render.com
# deploy-render
# Setup: A Blueprint from the repository; a paid plan (pre-deploy commands).
# Read by the render CLI.
RENDER_API_KEY=
# srv-...
MAYURA_DEPLOY_RENDER_SERVER_SERVICE_ID=
# srv-...
MAYURA_DEPLOY_RENDER_WORKER_SERVICE_ID=

# --- Google Cloud Run [no live check yet]  https://cloud.google.com/run
# deploy-cloudrun
# Setup: Secrets for DATABASE_URL and each env name in Secret Manager.
# Also uses: GOOGLE_CLOUD_PROJECT, GOOGLE_CLOUD_REGION, GOOGLE_APPLICATION_CREDENTIALS (set once, above or below).
# Artifact Registry, such as us-central1-docker.pkg.dev/<project>/apps/mayura-test.
MAYURA_DEPLOY_CLOUDRUN_IMAGE=

# --- AWS ECS Fargate [no live check yet]  https://aws.amazon.com/ecs/
# deploy-aws-ecs
# Setup: The <name>-server and <name>-worker services exist in the cluster.
# Also uses: AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY, AWS_REGION (set once, above or below).
MAYURA_DEPLOY_ECS_CLUSTER=
# subnet-...,subnet-...
MAYURA_DEPLOY_ECS_SUBNETS=
# sg-...
MAYURA_DEPLOY_ECS_SECURITY_GROUPS=
MAYURA_DEPLOY_ECS_EXECUTION_ROLE_ARN=
# Secrets Manager prefix for DATABASE_URL and env.
MAYURA_DEPLOY_ECS_SECRET_PREFIX=
# An ECR repository.
MAYURA_DEPLOY_ECS_IMAGE=

# --- AWS Lambda [no live check yet]  https://aws.amazon.com/lambda/
# deploy-aws-lambda
# Setup: The <name>-api, <name>-workflows and <name>-migrate functions exist.
# Also uses: AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY, AWS_REGION (set once, above or below).
# An ECR repository.
MAYURA_DEPLOY_LAMBDA_IMAGE=

# --- Amazon Bedrock AgentCore [no live check yet]  https://aws.amazon.com/bedrock/agentcore/
# deploy-agentcore
# Setup: The agent runtime exists (create-agent-runtime).
# Also uses: AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY, AWS_REGION (set once, above or below).
# name_x-XXXXXXXXXX
MAYURA_DEPLOY_AGENTCORE_RUNTIME_ID=
MAYURA_DEPLOY_AGENTCORE_ROLE_ARN=
# An ECR repository (linux/arm64).
MAYURA_DEPLOY_AGENTCORE_IMAGE=

# --- Azure Container Apps [no live check yet]  https://azure.microsoft.com/products/container-apps
# deploy-azure
# Setup: The <name>-server and <name>-worker apps and the <name>-migrate job exist.
# Also uses: AZURE_TENANT_ID, AZURE_CLIENT_ID, AZURE_CLIENT_SECRET, AZURE_SUBSCRIPTION_ID, AZURE_RESOURCE_GROUP (set once, above or below).
# <registry>.azurecr.io/<repo>
MAYURA_DEPLOY_AZURE_IMAGE=

# --- DigitalOcean App Platform [no live check yet]  https://www.digitalocean.com/products/app-platform
# deploy-digitalocean
# Read by doctl.
DIGITALOCEAN_ACCESS_TOKEN=
# A UUID, from doctl apps create.
MAYURA_DEPLOY_DO_APP_ID=
# registry.digitalocean.com/<registry>/<repo>
MAYURA_DEPLOY_DO_IMAGE=

# --- Vercel Functions [no live check yet]  https://vercel.com/docs/functions
# deploy-vercel
# Setup: vercel link; CRON_SECRET set in the Vercel project.
# Also uses: VERCEL_TOKEN, VERCEL_TEAM_ID, VERCEL_PROJECT_ID, DATABASE_URL (set once, above or below).

# --- Cloudflare Containers or Workers [no live check yet]  https://www.cloudflare.com
# deploy-cloudflare
# Also uses: CLOUDFLARE_API_TOKEN, CLOUDFLARE_ACCOUNT_ID, DATABASE_URL (set once, above or below).
