    "node": ">=22.12.0 <23 || >=24.14.1 <25"
  },
  "scripts": {
    "build": "node node_modules/typescript/bin/tsc --build",
    "typecheck": "node node_modules/typescript/bin/tsc --build --pretty false && node node_modules/typescript/bin/tsc --project tsconfig.tests.json && node node_modules/typescript/bin/tsc --project extensions/provider-mistral/tsconfig.test.json && node node_modules/typescript/bin/tsc --project packages/auth/tsconfig.better-auth.json && node node_modules/typescript/bin/tsc --project packages/inspector-ui/tsconfig.json",
    "test": "node node_modules/vitest/vitest.mjs run",
    "check": "pnpm typecheck && pnpm test",
    "test:consumer": "node scripts/consumer-check.mjs",
    "test:consumer:optional": "node scripts/optional-consumer-check.mjs",
    "test:consumer:storage": "node scripts/storage-consumer-check.mjs",
    "test:templates": "node scripts/template-check.mjs",
    "test:starters": "node scripts/starter-check.mjs",
    "local:init": "node scripts/local-init.mjs",
    "test:bundle": "node scripts/bundle-check.mjs",
    "docs:check": "node scripts/docs-check.mjs",
    "test:integration": "node node_modules/vitest/vitest.mjs run --project integration",
    "example": "node examples/first-agent.mjs",
    "providers:live-check": "node scripts/provider-live-check.mjs",
    "release:artifacts": "node scripts/release-artifact-check.mjs",
    "upgrade:compat": "node scripts/upgrade-compat.mjs",
    "api:report": "node scripts/api-report.mjs",
    "edge:check": "node scripts/edge-check.mjs",
    "test:runtimes": "node scripts/runtime-check.mjs",
    "console:check": "node scripts/inspector-bundle.mjs --check",
    "perf": "node scripts/perf-suite.mjs",
    "code-sandbox:image": "node scripts/code-sandbox-image.mjs",
    "server:image": "node scripts/server-image.mjs",
    "restore:drill:postgres": "node scripts/postgres-restore-drill.mjs",
    "secret-scan": "node scripts/secret-scan.mjs",
    "sbom": "node scripts/sbom.mjs",
    "release:publish": "node scripts/publish-staged.mjs",
    "code-sandbox:promote": "node scripts/code-sandbox-promote.mjs"
  },
